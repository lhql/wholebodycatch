<?xml version="1.0"?>
<model>
  <name>Iris with sensors and lightweight telescopic manipulation arm</name>
  <version>3.0</version>
  <sdf version="1.6">my.sdf</sdf>
  <author>
    <name>Lorenz Meier and Thomas Gubler (original Iris)</name>
    <email>lorenz@px4.io</email>
  </author>
  <description>
    Uses the local payload-rated Iris base; preserves MID360, D435i and FPV sensors.
    Adds 0.20 kg twin-skid gear and a 0.377 kg five-axis arm
    (yaw, shoulder pitch, extension, wrist pitch, tool roll) with two
    independently actuated gripper fingers and compliant contact pads.
    Includes a wrist-mounted RGB-D grasp camera (18 g with bracket).
    Near-horizontal initial posture; 0.14 m powered extension.
    Position/effort commands, joint feedback, wrist wrench and finger contacts
    use /my/arm. See README.md, arm.urdf and scripts/kinematics.py.
    Origin: skid soles; original aircraft base is at z=0.50 m.
    Build the local plugin using CMake before moving to another machine.
  </description>
</model>
