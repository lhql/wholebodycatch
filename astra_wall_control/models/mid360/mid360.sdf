<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mid360">
    <link name="lidar_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <pose>0 0 0 0 0 3.1415</pose>
        <geometry><mesh><uri>file:///home/li/AstraDroneOpen/simulation/astra_gazebo_models/mid360/meshes/livox_mid-360-90x.dae</uri></mesh></geometry>
      </collision>
      <visual name="lidar_visual">
        <pose>0 0 0 0 0 3.1415</pose>
        <geometry><mesh><uri>file:///home/li/AstraDroneOpen/simulation/astra_gazebo_models/mid360/meshes/livox_mid-360-90x.dae</uri></mesh></geometry>
      </visual>

      <sensor type="ray" name="laser_livox">
        <pose>0 0 0.05 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <plugin name="ros2_livox" filename="libros2_livox.so">
          <ros><namespace>/</namespace></ros>
          <ray>
            <scan>
              <horizontal><samples>100</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>50</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></vertical>
            </scan>
            <!-- The custom multiray Init does not initialize Gazebo's private
                 minRange, so GetRange() returns distance from the ray start.
                 Start at the optical origin to avoid a 0.2 m radial bias.
                 FAST-LIO preprocess.blind still rejects returns below 0.5 m. -->
            <range><min>0</min><max>40</max><resolution>0.01</resolution></range>
            <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
          </ray>
          <samples>20000</samples>
          <downsample>1</downsample>
          <csv_file_name>/home/li/AstraDroneOpen/AstraDrone_ros2_ws/src/livox_laser_simulation_ros2/scan_mode/mid360.csv</csv_file_name>
          <topic>/livox/lidar</topic>
        </plugin>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <pose>-0.011 -0.02329 0.04412 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/livox</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
